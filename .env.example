# Telegram ariza yuborish sozlamalari (backendsiz).
# Bu faylni `.env.local` nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env.local GitHub'ga YUKLANMAYDI (.gitignore da).

# @BotFather dan olingan bot tokeni
VITE_TELEGRAM_BOT_TOKEN=

# Kanal/guruh ID (masalan: -1001234567890). Bot o'sha kanalda ADMIN bo'lishi shart.
VITE_TELEGRAM_CHAT_ID=

# ── Backend (Express + SQLite) sozlamalari ─────────────────────────────
# Railway'da bu qiymatlarni Variables bo'limiga qo'shing.

# SQLite baza va yuklangan rasmlar papkasi. Railway'da volume /data ga ulanadi.
DATA_DIR=/data

# Admin paneli logini (/admin sahifasi)
ADMIN_EMAIL=admin@gulnorafarm.uz
ADMIN_PASSWORD=123@Gulnorafarm

# JWT maxfiy kaliti — ixtiyoriy uzun tasodifiy satr bilan almashtiring
JWT_SECRET=change-this-to-a-long-random-string
